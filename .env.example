# Public origin used for canonical URLs, sitemap.xml and OpenGraph tags.
SITE_URL=https://parseplayground.com

# Secrets — use long random strings in production (e.g. `openssl rand -base64 48`).
# Set these in Netlify: Site configuration > Environment variables.
JWT_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-a-different-long-random-string
